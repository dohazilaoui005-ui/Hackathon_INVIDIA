# Copy this file to .env for local development (never commit the real .env)

# If unset, the API automatically falls back to keyword-based extraction
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=20

# How long AI extraction results are cached per unique input text
CACHE_TTL_SECONDS=3600

# SQLite file path (fine for a prototype; swap for a managed DB in production)
DATABASE_PATH=./data/cases.db

FLASK_ENV=production
PORT=5000
